<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center_vertical"
    android:paddingStart="96dp" android:paddingEnd="96dp"
    android:background="#FF121218">

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="@string/app_name" android:textSize="40sp" android:textColor="#FFFFFFFF" />

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="@string/tagline" android:textSize="18sp" android:textColor="#FFA0A0AF" />

    <TextView android:id="@+id/status" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:paddingTop="32dp" android:paddingBottom="12dp" android:textSize="20sp" />

    <TextView android:id="@+id/command" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:paddingBottom="12dp" android:textSize="18sp" android:textColor="#FFFFFFFF"
        android:fontFamily="monospace" android:visibility="gone"
        android:text="adb shell appops set com.muniv24.volumebar SYSTEM_ALERT_WINDOW allow" />

    <Button android:id="@+id/toggle" style="@style/TvButton" />
    <Button android:id="@+id/test" style="@style/TvButton" android:text="@string/test" />
    <Button android:id="@+id/allow" style="@style/TvButton" android:text="@string/allow" />
</LinearLayout>
